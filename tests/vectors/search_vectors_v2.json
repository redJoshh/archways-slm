  "vectors": [
    {
      "name": "one long word becomes a 4-character stem; title matches score 2",
      "arguments": {
        "query": "library"
      },
      "expected_ids": [
        "v-01",
        "v-10"
      ],
      "expected_stems": [
        "libr"
      ]
    },
    {
      "name": "spelling variant: enrolment and enrollment share the stem enro",
      "arguments": {
        "query": "enrolment"
      },
      "expected_ids": [
        "v-12",
        "v-02"
      ],
      "expected_stems": [
        "enro"
      ]
    },
    {
      "name": "plural query matches the singular word",
      "arguments": {
        "query": "examinations"
      },
      "expected_ids": [
        "v-13"
      ],
      "expected_stems": [
        "exam"
      ]
    },
    {
      "name": "half of two stems is enough; more matched stems rank first",
      "arguments": {
        "query": "enrollment payment"
      },
      "expected_ids": [
        "v-12",
        "v-02"
      ],
      "expected_stems": [
        "enro",
        "paym"
      ]
    },
    {
      "name": "score, then newest: v-02 scores 3, v-12 and v-03 score 2",
      "arguments": {
        "query": "registrar enrollment"
      },
      "expected_ids": [
        "v-02",
        "v-12",
        "v-03"
      ],
      "expected_stems": [
        "regi",
        "enro"
      ]
    },
    {
      "name": "a title match (2) outranks a newer-or-equal body match (1)",
      "arguments": {
        "query": "registrar"
      },
      "expected_ids": [
        "v-03",
        "v-02"
      ],
      "expected_stems": [
        "regi"
      ]
    },
    {
      "name": "only stopwords: no results",
      "arguments": {
        "query": "the of"
      },
      "expected_ids": [],
      "expected_stems": []
    },
    {
      "name": "percent alone has no word characters: no results",
      "arguments": {
        "query": "%"
      },
      "expected_ids": [],
      "expected_stems": []
    },
    {
      "name": "asterisk alone has no word characters: no results",
      "arguments": {
        "query": "*"
      },
      "expected_ids": [],
      "expected_stems": []
    },
    {
      "name": "short words stay whole and must start a word",
      "arguments": {
        "query": "pm"
      },
      "expected_ids": [
        "v-01",
        "v-05"
      ],
      "expected_stems": [
        "pm"
      ]
    },
    {
      "name": "a short word matches the start of words split at underscores",
      "arguments": {
        "query": "off"
      },
      "expected_ids": [
        "v-04",
        "v-05"
      ],
      "expected_stems": [
        "off"
      ]
    },
    {
      "name": "underscore splits words; two matched stems outrank one",
      "arguments": {
        "query": "off_peak"
      },
      "expected_ids": [
        "v-05",
        "v-04"
      ],
      "expected_stems": [
        "off",
        "peak"
      ]
    },
    {
      "name": "three stems need two matches",
      "arguments": {
        "query": "library hours monday"
      },
      "expected_ids": [
        "v-01"
      ],
      "expected_stems": [
        "libr",
        "hour",
        "mond"
      ]
    },
    {
      "name": "old does not start with the stem olde; days 30",
      "arguments": {
        "query": "library older",
        "days": 30
      },
      "expected_ids": [
        "v-11",
        "v-01",
        "v-10"
      ],
      "expected_stems": [
        "libr",
        "olde"
      ]
    },
    {
      "name": "limit after ranking",
      "arguments": {
        "query": "library",
        "days": 30,
        "limit": 2
      },
      "expected_ids": [
        "v-01",
        "v-10"
      ],
      "expected_stems": [
        "libr"
      ]
    },
    {
      "name": "equal score and time ordered by id",
      "arguments": {
        "query": "notice",
        "days": 30
      },
      "expected_ids": [
        "v-06",
        "v-10",
        "v-11"
      ],
      "expected_stems": [
        "noti"
      ]
    },
    {
      "name": "digits are words",
      "arguments": {
        "query": "50%"
      },
      "expected_ids": [
        "v-04"
      ],
      "expected_stems": [
        "50"
      ]
    },
    {
      "name": "a one-letter word matches any word starting with it",
      "arguments": {
        "query": "c:\\shared"
      },
      "expected_ids": [
        "v-06",
        "v-12",
        "v-02"
      ],
      "expected_stems": [
        "c",
        "shar"
      ]
    },
    {
      "name": "empty query",
      "arguments": {
        "query": ""
      },
      "expected_error": true
    },
    {
      "name": "whitespace-only query",
      "arguments": {
        "query": "   "
      },
      "expected_error": true
    },
    {
      "name": "query over 200 characters",
      "arguments": {
        "query": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "expected_error": true
    },
    {
      "name": "days above 30",
      "arguments": {
        "query": "library",
        "days": 31
      },
      "expected_error": true
    },
    {
      "name": "unknown argument",
      "arguments": {
        "query": "library",
        "extra": 1
      },
      "expected_error": true
    }
  ]
}
